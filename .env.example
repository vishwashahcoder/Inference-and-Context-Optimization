# Production-Grade AI Inference & Context Optimization Platform Config

# API Keys (Get free keys at https://console.groq.com / https://aistudio.google.com)
GROQ_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=

# Provider Mode: "auto", "groq", "gemini", "hf", "mock"
DEFAULT_PROVIDER=auto

# Semantic Cache Threshold (Cosine similarity 0.88+)
CACHE_SIMILARITY_THRESHOLD=0.88

# Token Budget Default (Max tokens after RAG context compression)
DEFAULT_TOKEN_BUDGET=1500

# Model Router Mappings for Groq
MODEL_TIER_1_SMALL=openai/gpt-oss-120b
MODEL_TIER_2_MEDIUM=openai/gpt-oss-120b
MODEL_TIER_3_LARGE=openai/gpt-oss-120b

# LangChain / LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=inference
